Group=bernd
PAMName=login
TTYPath=/dev/tty1
Restart=no
RestartSec=10
#ExecStart=/usr/bin/bash -c /home/bernd/develop/fmtransmitter/qn8027ctrl/qn8027rest.sh
ExecStart=/home/bernd/develop/fmtransmitter/qn8027ctrl/qn8027rest.sh

[Install]
